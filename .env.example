# Which backend the demos use: "ollama" (local, free) or "anthropic" (cloud)
LLM_PROVIDER=ollama

# --- Ollama (Docker container exposing port 11434) ---
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b-instruct (~2.5 GB, Qwen3-4B-Instruct-2507): fits a 4 GB GPU, tool calling, no "thinking".
# Even lighter fallback: qwen3:1.7b
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window (tokens). Bigger = more VRAM.
OLLAMA_NUM_CTX=4096

# --- Langfuse tracing (optional; demo 13). Leave empty to disable. ---
# Self-hosted: LANGFUSE_BASE_URL=http://localhost:3000 ; Cloud: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
